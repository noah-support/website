# Runtime variables for the admin, landing flows, Postgres, and MinIO.
# Existing form variables (N8N_FORM_WEBHOOK_URL, RESEND_API_KEY, and the rest) stay as they are.

DATABASE_URL=postgresql://noah:noah@localhost:5433/noah
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio12345
S3_BUCKET=noah-assets
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
# Set to true only while testing. Skips the n8n lead capture and reCAPTCHA.
# Leave false: both stay on.
DISABLE_CAPTURES=false
# OpenRouter key. Defaults to Claude Sonnet 5.5 when the model is left as below.
AI_API_KEY=
AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=anthropic/claude-sonnet-5.5
